# Public URL of this deployment. Install commands, the sitemap and
# "Open in v0" links point here. Defaults to https://ui.balick.me.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Balick UI Pro (all optional) -------------------------------------------
# Without these, the site builds and runs with the free items only.

# Pro sources: a read-only GitHub token for the private Pro repository, used
# by scripts/pro.mjs to download it before a build (on Vercel). Locally, you
# can clone the repository into registry/pro instead.
# PRO_GITHUB_TOKEN=
# PRO_REPOSITORY=Balick/balick-ui-pro
# PRO_REPOSITORY_REF=main

# License keys, issued by Polar (License Keys benefit).
# POLAR_ORGANIZATION_ID=
# Optional: an organization access token with the license_keys:write scope.
# POLAR_ACCESS_TOKEN=
# Optional: only accept the keys of this benefit.
# POLAR_BENEFIT_ID=
# Optional: "sandbox" to test against sandbox.polar.sh.
# POLAR_SERVER=sandbox

# Keys that are always valid, comma separated (your own, or for tests).
# PRO_LICENSE_KEYS=

# Polar checkout links of the plans, shown on /pro.
# NEXT_PUBLIC_PRO_CHECKOUT_PERSONAL=
# NEXT_PUBLIC_PRO_CHECKOUT_TEAM=
