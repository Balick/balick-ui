{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sparkline-demo",
  "title": "Sparkline Demo",
  "description": "Example usage of Sparkline.",
  "registryDependencies": [
    "https://ui.balick.me/r/sparkline.json",
    "https://ui.balick.me/r/trend-badge.json"
  ],
  "files": [
    {
      "path": "registry/balick/examples/sparkline-demo.tsx",
      "content": "import { Sparkline } from \"@/registry/balick/ui/sparkline\"\nimport { TrendBadge } from \"@/registry/balick/ui/trend-badge\"\n\nconst revenue = [31, 34, 33, 38, 36, 41, 39, 44, 43, 47, 45, 52, 50, 56]\n\nexport default function SparklineDemo() {\n  return (\n    <div className=\"w-full max-w-64 rounded-xl border bg-card p-4 shadow-xs\">\n      <p className=\"text-xs text-muted-foreground\">Monthly revenue</p>\n      <div className=\"mt-1 flex items-center gap-2\">\n        <span className=\"text-2xl font-semibold tracking-tight tabular-nums\">$48,210</span>\n        <TrendBadge value={12.4} />\n      </div>\n      <Sparkline data={revenue} aria-label=\"Revenue over the last 14 weeks, up\" className=\"mt-4 h-14 w-full\" />\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}