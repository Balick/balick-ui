{
  "name": "balick-ui",
  "version": "0.1.0",
  "description": "Blocks for shadcn/ui, designed to fit together. Compose a page, then install it with one command.",
  "homepage": "https://ui.balick.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/Balick/balick-ui.git"
  },
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "registry",
    "blocks",
    "components",
    "react",
    "nextjs",
    "tailwindcss"
  ],
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "registry:build": "node scripts/sync-theme.mjs && node scripts/check-blocks.mjs && shadcn build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.487.0",
    "motion": "^13.4.4",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.9",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.5.9",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.2",
      "@types/react-dom": "19.1.2"
    }
  }
}
